POSTGRES_USER=blog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=blogs
PORT=8080
LOG_LEVEL=info
# Comma-separated list of origins allowed to make cross-origin requests
# (e.g. a local frontend dev server plus a deployed frontend URL).
# insanelyharsh/web-portfolio's frontend runs on :3000 by default.
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Comma-separated list of headers a cross-origin request is allowed to send.
CORS_ALLOWED_HEADERS=Content-Type,Authorization
# Only used for `go run ./cmd` on the host; docker-compose overrides this to
# point at the "postgres" service instead of localhost.
DATABASE_URL=postgres://blog:changeme@localhost:5432/blogs?sslmode=disable
